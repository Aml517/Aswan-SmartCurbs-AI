# Database Connection
DATABASE_URL=sqlite:///./smartcurbs.db
APP_ENV=development
APP_TITLE=Aswan SmartCurbs AI
APP_VERSION=0.1.0

# Live Video Stream Configuration (Windy Webcams / RTSP / HLS / USB Camera)
