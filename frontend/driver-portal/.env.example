# ======================
# Aswan SmartCurbs AI — Driver Portal
# Frontend Environment Variables
# ======================
# HOW TO USE:
# 1. Copy this file and rename the copy to .env
# 2. Fill in your actual values
# 3. NEVER commit .env to GitHub
# ======================

# Base URL of the FastAPI backend's v1 router
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Set to "true" to use in-memory mock data instead of the real backend
# (useful for demos if the backend/database isn't running)
VITE_USE_MOCK_DATA=false
