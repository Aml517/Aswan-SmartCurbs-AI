# Backend Environment Variables
# ======================
# HOW TO USE:
# 1. Copy this file and rename the copy to .env
# 2. Fill in your actual values in .env
# 3. NEVER commit .env to GitHub

# ======================
# Database
# ======================
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/smartcurbs_db

# ======================
# App Settings
# ======================
APP_ENV=development
APP_TITLE=Aswan SmartCurbs AI
APP_VERSION=0.1.0